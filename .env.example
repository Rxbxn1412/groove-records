# Opcional: copia este archivo como .env para cambiar los valores por defecto.
# Si no existe .env, docker compose usa los valores por defecto indicados en docker-compose.yml.

# Puertos de tu equipo (cámbialos si están ocupados)
WEB_PORT=5000
MAIL_WEB_PORT=8025
PGADMIN_PORT=5050

SECRET_KEY=pon-aqui-una-clave-larga-y-aleatoria

# PostgreSQL (el host dentro de Docker es siempre "db")
DB_NAME=tienda
DB_USER=tienda_user
DB_PASSWORD=tienda_pass

# pgAdmin (el correo debe tener formato válido)
PGADMIN_EMAIL=admin@grooverecords.com
PGADMIN_PASSWORD=admin1234

# Quien se registre con este correo será administrador (puede añadir discos)
ADMIN_EMAIL=admin@grooverecords.com

# Correo. Por defecto se usa el contenedor Mailpit (no hace falta tocar nada).
# Para usar un servidor SMTP real (ejemplo Gmail con "contraseña de aplicación"),
# descomenta y rellena:
#MAIL_SERVER=smtp.gmail.com
#MAIL_PORT=587
#MAIL_USE_TLS=true
#MAIL_USERNAME=tu_correo@gmail.com
#MAIL_PASSWORD=tu_contraseña_de_aplicacion
#MAIL_FROM=tu_correo@gmail.com
